# Docker Compose environment — salin menjadi .env lalu ISI nilai rahasia.
# Jangan commit file .env.

# Wajib diisi. Gunakan password yang kuat.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ubah-password-database-yang-kuat
POSTGRES_DB=pos_minimarket

# Wajib diisi, minimal 16 karakter acak. Server akan menolak berjalan bila
# nilainya kosong atau masih memakai nilai contoh ini.
# Buat dengan: openssl rand -base64 32
JWT_SECRET=ubah-dengan-string-acak-minimal-16-karakter
JWT_EXPIRES=12h

# Akun awal dibuat otomatis saat backend pertama dijalankan.
# Bila dikosongkan, backend membuat password acak dan mencetaknya SEKALI ke log
# (docker compose logs backend). Password tidak pernah disimpan di repo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
KASIR_USERNAME=kasir
KASIR_PASSWORD=
KASIR_FULL_NAME=Kasir Satu

# Daftar origin yang diizinkan, dipisah koma. Kosong = hanya origin yang sama.
CORS_ORIGIN=

# Host ports (ubah bila bentrok dengan service lain)
FRONTEND_HOST_PORT=9998
# Port HTTPS LAN untuk kamera HP (secure context). Lihat README bagian HTTPS.
FRONTEND_HTTPS_HOST_PORT=9999
BACKEND_HOST_PORT=5002
POSTGRES_HOST_PORT=5433

# Zona waktu toko untuk batas "hari ini"/"bulan ini" (KPI & laporan). Default WIB.
APP_TIMEZONE=Asia/Jakarta

# Sertifikat TLS dimount dari ./certs ke /etc/nginx/certs dengan nama tetap
# pos.crt / pos.key (lihat nginx/templates/default.conf.template). Bila ./certs
# kosong, container membuat self-signed cert otomatis. Lihat README bagian
# "HTTPS untuk kamera".
#
# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
